<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Discrete Probability Distributions Lab - AIML Coursework</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- KaTeX for crisp mathematical typography -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>
  <!-- Chart.js for responsive statistical distribution graphics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
      opacity: 1;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- Header Navigation -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
          <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
            &Sigma;
          </div>
          <div>
            <h1 class="text-base font-semibold text-slate-900 leading-tight">Discrete Probability Distributions</h1>
            <p class="text-xs text-slate-500 font-medium tracking-wide">AIML Applied Statistics Laboratory</p>
          </div>
        </div>

        <nav class="flex items-center space-x-1 sm:space-x-2 text-sm font-medium">
          <button id="nav-home" onclick="switchTab('home')" class="nav-btn px-3 py-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition">
            Home
          </button>
          <button id="nav-binomial" onclick="switchTab('binomial')" class="nav-btn px-3 py-2 rounded-md text-blue-600 bg-blue-50 font-semibold transition">
            Binomial
          </button>
          <button id="nav-poisson" onclick="switchTab('poisson')" class="nav-btn px-3 py-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition">
            Poisson
          </button>
          <button id="nav-geometric" onclick="switchTab('geometric')" class="nav-btn px-3 py-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition">
            Geometric
          </button>
        </nav>
      </div>
    </div>
  </header>

  <!-- Main Application Body -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- 0. HOME VIEW -->
    <section id="view-home" class="hidden space-y-8">
      <div class="bg-gradient-to-br from-indigo-800 via-indigo-900 to-slate-900 rounded-2xl p-8 sm:p-10 text-white shadow-md">
        <div class="max-w-3xl">
          <span class="inline-block px-3 py-1 bg-indigo-500/30 border border-indigo-400/40 rounded-full text-xs font-semibold uppercase tracking-wider mb-4">
            Undergraduate AIML Curriculum &bull; Probability Lab
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">
            Discrete Probability Distributions Laboratory
          </h2>
          <p class="text-indigo-100 text-base sm:text-lg leading-relaxed mb-6">
            A comprehensive interactive workbench exploring discrete stochastic models foundational to Machine Learning, Naive Bayes classifiers, queuing theory, failure modeling, and Bayesian estimation. Explore parameters, inspect theoretical moments, compute PMF and CDF values, and analyze live probability mass distributions.
          </p>
          <div class="flex flex-wrap gap-3">
            <button onclick="switchTab('binomial')" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-sm transition text-sm">
              Binomial Lab &rarr;
            </button>
            <button onclick="switchTab('poisson')" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-lg shadow-sm transition text-sm">
              Poisson Lab &rarr;
            </button>
            <button onclick="switchTab('geometric')" class="px-5 py-2.5 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-sm transition text-sm">
              Geometric Lab &rarr;
            </button>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Binomial Card -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between hover:border-blue-400 transition">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-100 text-blue-800">Module 01</span>
              <span class="text-xs text-slate-400 font-mono">X ~ B(n, p)</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Binomial Distribution</h3>
            <p class="text-sm text-slate-600 mb-4 leading-relaxed">
              Models the count of successes in \(n\) independent, identically distributed Bernoulli trials with success probability \(p\). Features moment verification, PMF/CDF tools, and dynamic bar plots.
            </p>
          </div>
          <button onclick="switchTab('binomial')" class="w-full mt-2 py-2 px-4 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm transition text-center">
            Launch Binomial Lab
          </button>
        </div>

        <!-- Poisson Card -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between hover:border-amber-400 transition">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800">Module 02</span>
              <span class="text-xs text-slate-400 font-mono">X ~ Pois(&lambda;)</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Poisson Distribution</h3>
            <p class="text-sm text-slate-600 mb-4 leading-relaxed">
              Models event arrivals occurring at a constant mean rate \(\lambda\) independently in fixed continuous intervals of time or space. Essential for queuing networks and server load analysis.
            </p>
          </div>
          <button onclick="switchTab('poisson')" class="w-full mt-2 py-2 px-4 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-medium text-sm transition text-center">
            Launch Poisson Lab
          </button>
        </div>

        <!-- Geometric Card -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between hover:border-purple-400 transition">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-purple-100 text-purple-800">Module 03</span>
              <span class="text-xs text-slate-400 font-mono">X ~ Geo(p)</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Geometric Distribution</h3>
            <p class="text-sm text-slate-600 mb-4 leading-relaxed">
              Models the number of independent Bernoulli trials required to achieve the first success. The sole discrete distribution possessing the memoryless property.
            </p>
          </div>
          <button onclick="switchTab('geometric')" class="w-full mt-2 py-2 px-4 rounded-lg bg-purple-600 hover:bg-purple-700 text-white font-medium text-sm transition text-center">
            Launch Geometric Lab
          </button>
        </div>
      </div>
    </section>

    <!-- 1. BINOMIAL VIEW -->
    <section id="view-binomial" class="space-y-6">
      
      <!-- Module Definition Header -->
      <div class="bg-white border border-slate-200 rounded-xl p-6 sm:p-7 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-5">
          <div>
            <div class="text-xs font-bold text-blue-600 uppercase tracking-wider">Module 01 &bull; Discrete Distribution</div>
            <h2 class="text-2xl font-bold text-slate-900 mt-0.5">Binomial Distribution: B(n, p)</h2>
          </div>
          <div class="flex items-center gap-2 text-xs text-slate-600 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg w-fit">
            <span>Model:</span>
            <span class="font-mono font-bold text-slate-900">X ~ Binomial(n, p)</span>
          </div>
        </div>

        <div class="bg-slate-50 border border-slate-200/80 rounded-lg p-5">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Probability Mass Function (PMF)</span>
              <div class="text-lg text-slate-900 font-serif pt-1">
                $$P(X = k) = \binom{n}{k} p^k (1-p)^{n-k}$$
              </div>
            </div>
            <div class="space-y-1 md:border-l md:border-slate-200 md:pl-5">
              <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Cumulative Distribution Function (CDF)</span>
              <div class="text-lg text-slate-900 font-serif pt-1">
                $$F(k) = P(X \le k) = \sum_{i=0}^{k} \binom{n}{i} p^i (1-p)^{n-i}$$
              </div>
            </div>
          </div>
          <div class="mt-3 pt-3 border-t border-slate-200 flex flex-wrap gap-y-1 gap-x-6 text-xs text-slate-600">
            <p><span class="font-semibold text-slate-800">Support:</span> \(k \in \{0, 1, 2, \dots, n\}\)</p>
            <p><span class="font-semibold text-slate-800">Mean:</span> \(\mu = np\)</p>
            <p><span class="font-semibold text-slate-800">Variance:</span> \(\sigma^2 = np(1-p)\)</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Parameter Inputs -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs">
            <div class="flex items-center justify-between pb-3 mb-5 border-b border-slate-100">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                Binomial Parameters
              </h3>
              <button onclick="resetBinomialDefaults()" class="text-xs font-medium text-blue-600 hover:text-blue-800 bg-blue-50 px-2.5 py-1 rounded transition">
                Reset Defaults
              </button>
            </div>

            <!-- Trials n -->
            <div class="mb-5">
              <div class="flex justify-between items-center mb-1.5">
                <label for="bin-input-n" class="text-sm font-semibold text-slate-700">Number of Trials (\(n\))</label>
                <span class="text-xs font-mono text-slate-400">Default: 20</span>
              </div>
              <input type="number" id="bin-input-n" step="1" value="20" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-lg text-slate-900 font-mono font-medium transition focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              <p id="bin-error-n" class="hidden text-xs text-rose-600 mt-1.5 font-medium">Validation Error: \(n\) must be a positive integer (\(n \ge 1\)).</p>
              <p class="text-xs text-slate-400 mt-1">Total count of identical Bernoulli experiments.</p>
            </div>

            <!-- Probability p -->
            <div class="mb-5">
              <div class="flex justify-between items-center mb-1.5">
                <label for="bin-input-p" class="text-sm font-semibold text-slate-700">Success Probability (\(p\))</label>
                <span class="text-xs font-mono text-slate-400">Default: 0.35</span>
              </div>
              <input type="number" id="bin-input-p" step="0.01" value="0.35" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-lg text-slate-900 font-mono font-medium transition focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              <p id="bin-error-p" class="hidden text-xs text-rose-600 mt-1.5 font-medium">Validation Error: \(p\) must satisfy \(0 \le p \le 1\).</p>
              <p class="text-xs text-slate-400 mt-1">Probability of success for each Bernoulli trial.</p>
            </div>

            <div id="bin-validation-banner" class="p-3 rounded-lg border text-xs font-medium bg-emerald-50 text-emerald-800 border-emerald-200 flex items-center gap-2">
              <span class="font-bold">✓ Parameters Valid:</span> Ready to compute moments and distribution.
            </div>
          </div>

          <!-- Parameter Summary Display -->
          <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs">
            <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">Selected Parameter State</h4>
            <div class="grid grid-cols-3 gap-3 text-center">
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100">
                <span class="text-[11px] text-slate-500 block">Trials (\(n\))</span>
                <span id="bin-display-n" class="text-lg font-bold font-mono text-blue-600">20</span>
              </div>
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100">
                <span class="text-[11px] text-slate-500 block">Success (\(p\))</span>
                <span id="bin-display-p" class="text-lg font-bold font-mono text-blue-600">0.35</span>
              </div>
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100">
                <span class="text-[11px] text-slate-500 block">Failure (\(q\))</span>
                <span id="bin-display-q" class="text-lg font-bold font-mono text-slate-700">0.65</span>
              </div>
            </div>
            <div class="mt-3 text-xs text-slate-600 flex justify-between items-center py-2 px-3 bg-slate-50 rounded-lg border border-slate-100">
              <span class="font-medium text-slate-500">Domain Support:</span>
              <span id="bin-display-support" class="font-mono font-semibold text-slate-800">{0, 1, ..., 20}</span>
            </div>
          </div>
        </div>

        <!-- Binomial Moments / Statistics -->
        <div class="lg:col-span-7 space-y-6">
          <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 mb-4 border-b border-slate-100 gap-2">
              <div>
                <h3 class="text-base font-bold text-slate-900">Binomial Moments &amp; Statistical Properties</h3>
                <p class="text-xs text-slate-500">Theoretical algebraic moment calculations</p>
              </div>
              <div id="bin-benchmark-badge" class="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 w-fit">
                <span>Default Benchmarks Verified</span>
              </div>
            </div>

            <!-- Verification notification -->
            <div id="bin-benchmark-callout" class="p-3 mb-4 rounded-lg border border-blue-200 bg-blue-50/70 text-xs text-blue-900">
              <p class="font-semibold">Laboratory Verification Checkpoint:</p>
              <p class="mt-0.5">For default parameters <span class="font-mono font-bold">n = 20, p = 0.35</span>: Mean = <strong class="font-mono">7.00</strong> and Variance = <strong class="font-mono">4.55</strong>.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Mean -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <div class="text-xs text-slate-500 font-medium mb-1">Mean (Expected Value)</div>
                <div class="text-2xl font-black font-mono text-blue-600" id="bin-stat-mean">7.00</div>
                <div class="mt-2 pt-2 border-t border-slate-200 flex justify-between text-xs">
                  <span class="text-slate-500">Formula:</span>
                  <span class="font-mono font-semibold text-slate-800">np</span>
                </div>
              </div>

              <!-- Variance -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <div class="text-xs text-slate-500 font-medium mb-1">Variance (\(\sigma^2\))</div>
                <div class="text-2xl font-black font-mono text-indigo-600" id="bin-stat-var">4.55</div>
                <div class="mt-2 pt-2 border-t border-slate-200 flex justify-between text-xs">
                  <span class="text-slate-500">Formula:</span>
                  <span class="font-mono font-semibold text-slate-800">np(1 - p)</span>
                </div>
              </div>

              <!-- Standard Deviation -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <div class="text-xs text-slate-500 font-medium mb-1">Standard Deviation (\(\sigma\))</div>
                <div class="text-2xl font-black font-mono text-slate-800" id="bin-stat-sd">2.1331</div>
                <div class="mt-2 pt-2 border-t border-slate-200 flex justify-between text-xs">
                  <span class="text-slate-500">Formula:</span>
                  <span class="font-mono font-semibold text-slate-800">\(\sqrt{\mathrm{Var}(X)}\)</span>
                </div>
              </div>

              <!-- Second Moment -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <div class="text-xs text-slate-500 font-medium mb-1">Second Moment (\(E[X^2]\))</div>
                <div class="text-2xl font-black font-mono text-slate-800" id="bin-stat-second">53.55</div>
                <div class="mt-2 pt-2 border-t border-slate-200 flex justify-between text-xs">
                  <span class="text-slate-500">Formula:</span>
                  <span class="font-mono font-semibold text-slate-800">\(\mathrm{Var}(X) + \mathrm{Mean}^2\)</span>
                </div>
              </div>

              <!-- Skewness -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 sm:col-span-2">
                <div class="text-xs text-slate-500 font-medium mb-1">Skewness (\(\gamma_1\))</div>
                <div class="flex items-baseline gap-3">
                  <div class="text-2xl font-black font-mono text-amber-600" id="bin-stat-skew">0.1406</div>
                  <span id="bin-skew-desc" class="text-xs text-slate-500">(Slight right skew)</span>
                </div>
                <div class="mt-2 pt-2 border-t border-slate-200 flex justify-between text-xs">
                  <span class="text-slate-500">Formula:</span>
                  <span class="font-mono font-semibold text-slate-800">\((1 - 2p) / \sqrt{np(1-p)}\)</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Binomial PMF Bar Chart -->
      <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 mb-4 border-b border-slate-100 gap-2">
          <div>
            <h3 class="text-base font-bold text-slate-900">Binomial PMF Visual Distribution</h3>
            <p class="text-xs text-slate-500">Bar chart plotting \(P(X = x)\) for \(X \in \{0, 1, \dots, n\}\) with vertical dashed Mean line</p>
          </div>
          <div class="flex items-center gap-3 text-xs">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 bg-blue-500 rounded-xs inline-block"></span> \(P(X)\)</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 bg-amber-500 rounded-xs inline-block"></span> Selected \(k\)</span>
            <span class="flex items-center gap-1.5 text-rose-600 font-medium"><span class="w-3 border-b-2 border-dashed border-rose-500 inline-block"></span> Mean (\(\mu\))</span>
          </div>
        </div>
        <div class="relative w-full h-72 sm:h-80">
          <canvas id="binChart"></canvas>
        </div>
      </div>

      <!-- Binomial PMF and CDF Calculators -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Binomial PMF Calculator -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
              <h3 class="text-base font-bold text-slate-900">PMF Calculator: \(P(X = k)\)</h3>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold border border-blue-200">Point Mass</span>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-center mb-4">
              <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-1">Formula</span>
              <div class="text-sm font-serif">$$P(X = k) = \binom{n}{k} p^k (1-p)^{n-k}$$</div>
            </div>

            <div class="mb-4">
              <label for="bin-k-pmf" class="text-sm font-semibold text-slate-700 flex justify-between">
                <span>Value of \(k\):</span>
                <span class="text-xs font-normal text-slate-400" id="bin-bounds-pmf">(0 &le; k &le; 20)</span>
              </label>
              <div class="grid grid-cols-12 gap-3 mt-1.5 items-center">
                <input type="number" id="bin-k-pmf" value="7" class="col-span-4 px-3 py-2 text-sm bg-slate-50 border border-slate-300 rounded-lg font-mono font-bold">
                <input type="range" id="bin-slider-pmf" min="0" max="20" value="7" class="col-span-8 h-2 bg-slate-200 rounded-lg accent-blue-600 cursor-pointer">
              </div>
              <p id="bin-error-k-pmf" class="hidden text-xs text-rose-600 mt-1 font-medium">Invalid \(k\): must satisfy \(0 \le k \le n\).</p>
            </div>

            <div class="bg-blue-50/70 border border-blue-200 rounded-xl p-4 mb-4">
              <div class="flex justify-between text-xs text-blue-900 font-semibold mb-1">
                <span>Result</span>
                <span id="bin-pmf-label" class="font-mono">P(X = 7)</span>
              </div>
              <div class="flex items-baseline justify-between">
                <span id="bin-pmf-val" class="text-3xl font-black font-mono text-blue-700">0.1844</span>
                <span id="bin-pmf-pct" class="text-sm font-bold font-mono bg-blue-100 text-blue-800 px-2 py-0.5 rounded">18.44%</span>
              </div>
            </div>
          </div>
          <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-xs text-slate-700">
            <span class="font-bold text-slate-900 block mb-0.5">Educational Explanation:</span>
            <p id="bin-pmf-exp">The probability of getting exactly 7 successes out of 20 independent trials is 18.44%.</p>
          </div>
        </div>

        <!-- Binomial CDF Calculator -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
