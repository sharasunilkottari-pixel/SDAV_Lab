  <!-- JAVASCRIPT LOGIC -->
  <script>
    // Tab switching mechanism
    const tabs = ['home', 'binomial', 'poisson', 'geometric'];

    function switchTab(targetTab) {
      tabs.forEach(tab => {
        const view = document.getElementById(`view-${tab}`);
        const navBtn = document.getElementById(`nav-${tab}`);
        
        if (tab === targetTab) {
          view.classList.remove('hidden');
          navBtn.classList.add('text-indigo-600', 'bg-indigo-50', 'font-semibold');
          navBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');
        } else {
          view.classList.add('hidden');
          navBtn.classList.remove('text-indigo-600', 'bg-indigo-50', 'font-semibold');
          navBtn.classList.add('text-slate-600', 'hover:bg-slate-100');
        }
      });

      renderMath();
      if (targetTab === 'binomial' && binChart) binChart.resize();
      if (targetTab === 'poisson' && poisChart) poisChart.resize();
      if (targetTab === 'geometric' && geomChart) geomChart.resize();
    }

    // Mathematical utility functions
    function logGamma(z) {
      const c = [
        57.1562356658629235, -59.5979603554754912,
        14.1360979747417471, -0.491913816097620199,
        0.339946499848118887e-4, 0.465236289270485756e-4,
        -0.983744753048795646e-4, 0.158088703224377309e-3,
        -0.210264441724104883e-3, 0.217439618115212643e-3,
        -0.164318106536763890e-3, 0.844182239838527433e-4,
        -0.261908384015814087e-4, 0.368991826595316234e-5
      ];
      let x = 0.99999999999999709182;
      for (let i = 0; i < c.length; i++) x += c[i] / (z + i + 1);
      const t = z + c.length - 0.5;
      return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x) - Math.log(z);
    }

    function logFact(n) {
      if (n <= 1) return 0;
      return logGamma(n + 1);
    }

    function formatNumber(num, digits = 4) {
      if (Number.isInteger(num)) return num.toString();
      const fixed = num.toFixed(digits);
      return fixed.replace(/\.?0+$/, "");
    }

    // Chart.js Plugin: Vertical Dashed Line at Theoretical Mean
    const meanReferenceLinePlugin = {
      id: 'meanReferenceLine',
      afterDatasetsDraw(chart, args, options) {
        const { ctx, chartArea: { top, bottom, left, right }, scales: { x } } = chart;
        const meanVal = options.mean;
        if (meanVal === undefined || isNaN(meanVal)) return;

        const labels = chart.data.labels;
        if (!labels || labels.length === 0) return;

        // Map meanVal to categorical pixel coordinate
        const firstVal = parseFloat(labels[0]);
        const lastVal = parseFloat(labels[labels.length - 1]);
        if (meanVal < firstVal || meanVal > lastVal) return;

        // Interpolate pixel position
        const lowerIdx = Math.max(0, Math.min(labels.length - 1, Math.floor(meanVal - firstVal)));
        const upperIdx = Math.max(0, Math.min(labels.length - 1, Math.ceil(meanVal - firstVal)));
        const lowerPixel = x.getPixelForTick(lowerIdx);
        const upperPixel = x.getPixelForTick(upperIdx);
        const frac = (meanVal - firstVal) - lowerIdx;
        const xPixel = lowerPixel + frac * (upperPixel - lowerPixel);

        ctx.save();
        ctx.setLineDash([5, 5]);
        ctx.strokeStyle = '#ef4444';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(xPixel, top);
        ctx.lineTo(xPixel, bottom);
        ctx.stroke();

        ctx.setLineDash([]);
        ctx.fillStyle = '#ef4444';
        ctx.font = 'bold 11px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'bottom';
        let textX = xPixel;
        const labelText = `Mean (μ = ${meanVal.toFixed(2)})`;
        const textWidth = ctx.measureText(labelText).width;
        if (textX - textWidth / 2 < left) textX = left + textWidth / 2 + 4;
        if (textX + textWidth / 2 > right) textX = right - textWidth / 2 - 4;
        ctx.fillText(labelText, textX, top - 4);
        ctx.restore();
      }
    };
    Chart.register(meanReferenceLinePlugin);

    // ==========================================
    // 1. BINOMIAL DISTRIBUTION LOGIC
    // ==========================================
    let binChart = null;

    function binomialPmf(k, n, p) {
      if (k < 0 || k > n || !Number.isInteger(k)) return 0;
      if (p === 0) return k === 0 ? 1 : 0;
      if (p === 1) return k === n ? 1 : 0;
      if (n <= 30) {
        let comb = 1;
        for (let i = 1; i <= k; i++) comb = (comb * (n - i + 1)) / i;
        return comb * Math.pow(p, k) * Math.pow(1 - p, n - k);
      }
      const logComb = logFact(n) - (logFact(k) + logFact(n - k));
      return Math.exp(logComb + k * Math.log(p) + (n - k) * Math.log(1 - p));
    }

    function binomialCdf(k, n, p) {
      if (k < 0) return 0;
      if (k >= n) return 1;
      let sum = 0;
      for (let i = 0; i <= k; i++) sum += binomialPmf(i, n, p);
      return Math.min(1, Math.max(0, sum));
    }

    function updateBinomialChart(n, p, activeK) {
      const labels = [];
      const data = [];
      const bgColors = [];
      const borderColors = [];

      for (let x = 0; x <= n; x++) {
        labels.push(x.toString());
        data.push(binomialPmf(x, n, p));
        if (x === activeK) {
          bgColors.push('rgba(245, 158, 11, 0.85)');
          borderColors.push('#d97706');
        } else {
          bgColors.push('rgba(59, 130, 246, 0.65)');
          borderColors.push('#2563eb');
        }
      }

      const mean = n * p;
      const ctx = document.getElementById('binChart').getContext('2d');

      if (binChart) {
        binChart.data.labels = labels;
        binChart.data.datasets[0].data = data;
        binChart.data.datasets[0].backgroundColor = bgColors;
        binChart.data.datasets[0].borderColor = borderColors;
        binChart.options.plugins.meanReferenceLine.mean = mean;
        binChart.update();
      } else {
        binChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'P(X = x)',
              data: data,
              backgroundColor: bgColors,
              borderColor: borderColors,
              borderWidth: 1.5,
              borderRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: { padding: { top: 20, right: 15, left: 10, bottom: 5 } },
            onClick: (e, elements) => {
              if (elements.length > 0) {
                const clickedIdx = elements[0].index;
                syncBinomialK(clickedIdx);
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  title: (items) => `X = ${items[0].label}`,
                  label: (item) => `P(X=${item.label}) = ${item.raw.toFixed(4)} (${(item.raw * 100).toFixed(2)}%)`
                }
              },
              meanReferenceLine: { mean: mean }
            },
            scales: {
              x: {
                title: { display: true, text: 'Number of Successes (X)', font: { weight: 'bold' } },
                grid: { display: false }
              },
              y: {
                beginAtZero: true,
                title: { display: true, text: 'Probability P(X)', font: { weight: 'bold' } },
                grid: { strokeDashArray: [3, 3] }
              }
            }
          }
        });
      }
    }

    function syncBinomialK(val) {
      val = Math.round(Number(val));
      const n = Number(document.getElementById('bin-input-n').value);
      if (val >= 0 && val <= n) {
        document.getElementById('bin-k-pmf').value = val;
        document.getElementById('bin-slider-pmf').value = val;
        document.getElementById('bin-k-cdf').value = val;
        document.getElementById('bin-slider-cdf').value = val;
        computeBinomial();
      }
    }

    function resetBinomialDefaults() {
      document.getElementById('bin-input-n').value = 20;
      document.getElementById('bin-input-p').value = 0.35;
      syncBinomialK(7);
      computeBinomial();
    }

    function computeBinomial() {
      const rawN = document.getElementById('bin-input-n').value.trim();
      const rawP = document.getElementById('bin-input-p').value.trim();
      const n = Number(rawN);
      const p = Number(rawP);

      const isNValid = rawN !== "" && !isNaN(n) && Number.isInteger(n) && n >= 1;
      const isPValid = rawP !== "" && !isNaN(p) && p >= 0 && p <= 1;

      document.getElementById('bin-error-n').classList.toggle('hidden', isNValid);
      document.getElementById('bin-error-p').classList.toggle('hidden', isPValid);

      if (!isNValid || !isPValid) return;

      const q = 1 - p;
      const mean = n * p;
      const variance = n * p * q;
      const sd = Math.sqrt(variance);
      const secondMoment = variance + Math.pow(mean, 2);
      const skewness = variance > 0 ? (1 - 2 * p) / Math.sqrt(variance) : 0;

      // Parameter Display
      document.getElementById('bin-display-n').textContent = n;
      document.getElementById('bin-display-p').textContent = formatNumber(p, 4);
      document.getElementById('bin-display-q').textContent = formatNumber(q, 4);
      document.getElementById('bin-display-support').textContent = n <= 5 ? `{${Array.from({length: n+1}, (_, i) => i).join(', ')}}` : `{0, 1, ..., ${n}}`;

      // Statistics
      document.getElementById('bin-stat-mean').textContent = formatNumber(mean, 4);
      document.getElementById('bin-stat-var').textContent = formatNumber(variance, 4);
      document.getElementById('bin-stat-sd').textContent = formatNumber(sd, 4);
      document.getElementById('bin-stat-second').textContent = formatNumber(secondMoment, 4);
      document.getElementById('bin-stat-skew').textContent = formatNumber(skewness, 4);

      // Benchmark verification check for n=20, p=0.35
      const isDefault = (n === 20 && Math.abs(p - 0.35) < 1e-4);
      document.getElementById('bin-benchmark-badge').classList.toggle('hidden', !isDefault);
      document.getElementById('bin-benchmark-callout').classList.toggle('hidden', !isDefault);

      // Slider bounds
      document.getElementById('bin-slider-pmf').max = n;
      document.getElementById('bin-slider-cdf').max = n;
      document.getElementById('bin-bounds-pmf').textContent = `(0 \u2264 k \u2264 ${n})`;
      document.getElementById('bin-bounds-cdf').textContent = `(0 \u2264 k \u2264 ${n})`;

      // Current k
      let k = Number(document.getElementById('bin-k-pmf').value);
      if (isNaN(k) || k < 0 || k > n) {
        k = Math.min(n, Math.max(0, Math.round(mean)));
        document.getElementById('bin-k-pmf').value = k;
        document.getElementById('bin-slider-pmf').value = k;
        document.getElementById('bin-k-cdf').value = k;
        document.getElementById('bin-slider-cdf').value = k;
      }

      // PMF
      const pmf = binomialPmf(k, n, p);
      document.getElementById('bin-pmf-label').textContent = `P(X = ${k})`;
      document.getElementById('bin-pmf-val').textContent = pmf.toFixed(4);
      document.getElementById('bin-pmf-pct').textContent = `${(pmf * 100).toFixed(2)}%`;
      document.getElementById('bin-pmf-exp').textContent = `The probability of getting exactly ${k} successes out of ${n} independent trials is ${(pmf * 100).toFixed(2)}%.`;

      // CDF
      const cdf = binomialCdf(k, n, p);
      const survival = Math.max(0, 1 - cdf);
      document.getElementById('bin-cdf-leq-lbl').textContent = `P(X \u2264 ${k})`;
      document.getElementById('bin-cdf-gt-lbl').textContent = `P(X > ${k})`;
      document.getElementById('bin-cdf-leq-val').textContent = cdf.toFixed(4);
      document.getElementById('bin-cdf-leq-pct').textContent = `${(cdf * 100).toFixed(2)}%`;
      document.getElementById('bin-cdf-gt-val').textContent = survival.toFixed(4);
      document.getElementById('bin-cdf-gt-pct').textContent = `${(survival * 100).toFixed(2)}%`;
      document.getElementById('bin-exp-k').textContent = k;
      document.getElementById('bin-exp-kgt').textContent = k;

      updateBinomialChart(n, p, k);
    }

    // ==========================================
    // 2. POISSON DISTRIBUTION LOGIC
    // ==========================================
    let poisChart = null;

    function poissonPmf(k, lambda) {
      if (k < 0 || !Number.isInteger(k)) return 0;
      if (lambda <= 0) return k === 0 ? 1 : 0;
      // Stable log-space calculation
      const logProb = k * Math.log(lambda) - lambda - logFact(k);
      return Math.exp(logProb);
    }

    function poissonCdf(k, lambda) {
      if (k < 0) return 0;
      let sum = 0;
      for (let i = 0; i <= k; i++) sum += poissonPmf(i, lambda);
      return Math.min(1, Math.max(0, sum));
    }

    function updatePoissonChart(lambda, activeK) {
      const labels = [];
      const data = [];
      const bgColors = [];
      const borderColors = [];

      // Determine clean dynamic display cutoff: max(15, ceil(lambda + 4*sqrt(lambda)))
      const sd = Math.sqrt(lambda);
      const maxCutoff = Math.max(14, Math.ceil(lambda + 4 * sd));

      for (let x = 0; x <= maxCutoff; x++) {
        labels.push(x.toString());
        data.push(poissonPmf(x, lambda));
        if (x === activeK) {
          bgColors.push('rgba(59, 130, 246, 0.9)');
          borderColors.push('#1d4ed8');
        } else {
          bgColors.push('rgba(245, 158, 11, 0.7)');
          borderColors.push('#d97706');
        }
      }

      const ctx = document.getElementById('poisChart').getContext('2d');

      if (poisChart) {
        poisChart.data.labels = labels;
        poisChart.data.datasets[0].data = data;
        poisChart.data.datasets[0].backgroundColor = bgColors;
        poisChart.data.datasets[0].borderColor = borderColors;
        poisChart.options.plugins.meanReferenceLine.mean = lambda;
        poisChart.update();
      } else {
        poisChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'P(X = x)',
              data: data,
              backgroundColor: bgColors,
              borderColor: borderColors,
              borderWidth: 1.5,
              borderRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: { padding: { top: 20, right: 15, left: 10, bottom: 5 } },
            onClick: (e, elements) => {
              if (elements.length > 0) {
                const clickedIdx = elements[0].index;
                syncPoissonK(clickedIdx);
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  title: (items) => `X = ${items[0].label}`,
                  label: (item) => `P(X=${item.label}) = ${item.raw.toFixed(4)} (${(item.raw * 100).toFixed(2)}%)`
                }
              },
              meanReferenceLine: { mean: lambda }
            },
            scales: {
              x: {
                title: { display: true, text: 'Number of Events (X)', font: { weight: 'bold' } },
                grid: { display: false }
              },
              y: {
                beginAtZero: true,
                title: { display: true, text: 'Probability P(X)', font: { weight: 'bold' } },
                grid: { strokeDashArray: [3, 3] }
              }
            }
          }
        });
      }
    }

    function syncPoissonK(val) {
      val = Math.max(0, Math.round(Number(val)));
      document.getElementById('pois-k-pmf').value = val;
      document.getElementById('pois-slider-pmf').value = Math.min(15, val);
      document.getElementById('pois-k-cdf').value = val;
      document.getElementById('pois-slider-cdf').value = Math.min(15, val);
      computePoisson();
    }

    function resetPoissonDefaults() {
      document.getElementById('pois-input-lambda').value = 4.0;
      syncPoissonK(4);
      computePoisson();
    }

    function computePoisson() {
      const rawLambda = document.getElementById('pois-input-lambda').value.trim();
      const lambda = Number(rawLambda);
      const isLambdaValid = rawLambda !== "" && !isNaN(lambda) && lambda > 0;

      document.getElementById('pois-error-lambda').classList.toggle('hidden', isLambdaValid);
      if (!isLambdaValid) return;

      const mean = lambda;
      const variance = lambda;
      const sd = Math.sqrt(lambda);
      const secondMoment = lambda + Math.pow(lambda, 2);
      const skewness = 1 / Math.sqrt(lambda);

      // Display Parameter
      document.getElementById('pois-display-lambda').textContent = formatNumber(lambda, 4);

      // Display Moments
      document.getElementById('pois-stat-mean').textContent = formatNumber(mean, 4);
      document.getElementById('pois-stat-var').textContent = formatNumber(variance, 4);
      document.getElementById('pois-stat-sd').textContent = formatNumber(sd, 4);
      document.getElementById('pois-stat-second').textContent = formatNumber(secondMoment, 4);
      document.getElementById('pois-stat-skew').textContent = formatNumber(skewness, 4);

      // Benchmark verification check for lambda = 4.0: Mean=4, Var=4, E[X^2]=20, Skewness=0.5
      const isDefault = Math.abs(lambda - 4.0) < 1e-4;
      document.getElementById('pois-benchmark-badge').classList.toggle('hidden', !isDefault);
      document.getElementById('pois-benchmark-callout').classList.toggle('hidden', !isDefault);

      // Dynamic slider max
      const sliderMax = Math.max(15, Math.ceil(lambda + 3 * sd));
      document.getElementById('pois-slider-pmf').max = sliderMax;
      document.getElementById('pois-slider-cdf').max = sliderMax;

      let k = Number(document.getElementById('pois-k-pmf').value);
      if (isNaN(k) || k < 0) {
        k = Math.round(lambda);
        document.getElementById('pois-k-pmf').value = k;
        document.getElementById('pois-slider-pmf').value = k;
        document.getElementById('pois-k-cdf').value = k;
        document.getElementById('pois-slider-cdf').value = k;
      }

      // PMF
      const pmf = poissonPmf(k, lambda);
      document.getElementById('pois-pmf-label').textContent = `P(X = ${k})`;
      document.getElementById('pois-pmf-val').textContent = pmf.toFixed(4);
      document.getElementById('pois-pmf-pct').textContent = `${(pmf * 100).toFixed(2)}%`;
      document.getElementById('pois-pmf-exp').textContent = `The probability of observing exactly ${k} events in the interval is ${(pmf * 100).toFixed(2)}%.`;

      // CDF
      const cdf = poissonCdf(k, lambda);
      const survival = Math.max(0, 1 - cdf);
      document.getElementById('pois-cdf-leq-lbl').textContent = `P(X \u2264 ${k})`;
      document.getElementById('pois-cdf-gt-lbl').textContent = `P(X > ${k})`;
      document.getElementById('pois-cdf-leq-val').textContent = cdf.toFixed(4);
      document.getElementById('pois-cdf-leq-pct').textContent = `${(cdf * 100).toFixed(2)}%`;
      document.getElementById('pois-cdf-gt-val').textContent = survival.toFixed(4);
      document.getElementById('pois-cdf-gt-pct').textContent = `${(survival * 100).toFixed(2)}%`;
      document.getElementById('pois-exp-k').textContent = k;
      document.getElementById('pois-exp-kgt').textContent = k;

      updatePoissonChart(lambda, k);
    }

    // ==========================================
    // 3. GEOMETRIC DISTRIBUTION LOGIC
    // ==========================================
    let geomChart = null;

    // Geometric (Trials until first success: X in {1, 2, 3, ...})
    function geometricPmf(k, p) {
      if (k < 1 || !Number.isInteger(k)) return 0;
      if (p <= 0 || p > 1) return 0;
      return Math.pow(1 - p, k - 1) * p;
    }

    function geometricCdf(k, p) {
      if (k < 1) return 0;
      if (p >= 1) return 1;
      return 1 - Math.pow(1 - p, k);
    }

    function updateGeometricChart(p, activeK) {
      const labels = [];
      const data = [];
      const bgColors = [];
      const borderColors = [];

      const mean = 1 / p;
      const sd = Math.sqrt(1 - p) / p;
      const maxCutoff = Math.min(40, Math.max(12, Math.ceil(mean + 3 * sd)));

      for (let x = 1; x <= maxCutoff; x++) {
        labels.push(x.toString());
        data.push(geometricPmf(x, p));
        if (x === activeK) {
          bgColors.push('rgba(245, 158, 11, 0.9)');
          borderColors.push('#d97706');
        } else {
          bgColors.push('rgba(147, 51, 234, 0.7)');
          borderColors.push('#7e22ce');
        }
      }

      const ctx = document.getElementById('geomChart').getContext('2d');

      if (geomChart) {
        geomChart.data.labels = labels;
        geomChart.data.datasets[0].data = data;
        geomChart.data.datasets[0].backgroundColor = bgColors;
        geomChart.data.datasets[0].borderColor = borderColors;
        geomChart.options.plugins.meanReferenceLine.mean = mean;
        geomChart.update();
      } else {
        geomChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'P(X = x)',
              data: data,
              backgroundColor: bgColors,
              borderColor: borderColors,
              borderWidth: 1.5,
              borderRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: { padding: { top: 20, right: 15, left: 10, bottom: 5 } },
            onClick: (e, elements) => {
              if (elements.length > 0) {
                const clickedIdx = elements[0].index;
                // Category starts from X = 1
                syncGeometricK(clickedIdx + 1);
              }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  title: (items) => `X = ${items[0].label} (Trial #${items[0].label})`,
                  label: (item) => `P(X=${item.label}) = ${item.raw.toFixed(4)} (${(item.raw * 100).toFixed(2)}%)`
                }
              },
              meanReferenceLine: { mean: mean }
            },
            scales: {
              x: {
                title: { display: true, text: 'Trial Number of 1st Success (X)', font: { weight: 'bold' } },
                grid: { display: false }
              },
              y: {
                beginAtZero: true,
                title: { display: true, text: 'Probability P(X)', font: { weight: 'bold' } },
                grid: { strokeDashArray: [3, 3] }
              }
            }
          }
        });
      }
    }

    function syncGeometricK(val) {
      val = Math.max(1, Math.round(Number(val)));
      document.getElementById('geom-k-pmf').value = val;
      document.getElementById('geom-slider-pmf').value = Math.min(20, val);
      document.getElementById('geom-k-cdf').value = val;
      document.getElementById('geom-slider-cdf').value = Math.min(20, val);
      computeGeometric();
    }

    function resetGeometricDefaults() {
      document.getElementById('geom-input-p').value = 0.25;
      syncGeometricK(4);
      computeGeometric();
    }

    function computeGeometric() {
      const rawP = document.getElementById('geom-input-p').value.trim();
      const p = Number(rawP);
      const isPValid = rawP !== "" && !isNaN(p) && p > 0 && p <= 1;

      document.getElementById('geom-error-p').classList.toggle('hidden', isPValid);
      if (!isPValid) return;

      const q = 1 - p;
      const mean = 1 / p;
      const variance = q / (p * p);
      const sd = Math.sqrt(variance);
      const secondMoment = (2 - p) / (p * p);
      const skewness = q > 0 ? (2 - p) / Math.sqrt(q) : 0;

      // Display Parameter
      document.getElementById('geom-display-p').textContent = formatNumber(p, 4);
      document.getElementById('geom-display-q').textContent = formatNumber(q, 4);

      // Display Moments
      document.getElementById('geom-stat-mean').textContent = formatNumber(mean, 4);
      document.getElementById('geom-stat-var').textContent = formatNumber(variance, 4);
      document.getElementById('geom-stat-sd').textContent = formatNumber(sd, 4);
      document.getElementById('geom-stat-second').textContent = formatNumber(secondMoment, 4);
      document.getElementById('geom-stat-skew').textContent = formatNumber(skewness, 4);

      // Benchmark verification check for p = 0.25: Mean=4, Var=12, SD=3.4641
      const isDefault = Math.abs(p - 0.25) < 1e-4;
      document.getElementById('geom-benchmark-badge').classList.toggle('hidden', !isDefault);
      document.getElementById('geom-benchmark-callout').classList.toggle('hidden', !isDefault);

      // Slider bounds
      const sliderMax = Math.min(30, Math.max(15, Math.ceil(mean + 2 * sd)));
      document.getElementById('geom-slider-pmf').max = sliderMax;
      document.getElementById('geom-slider-cdf').max = sliderMax;

      let k = Number(document.getElementById('geom-k-pmf').value);
      if (isNaN(k) || k < 1) {
        k = Math.max(1, Math.round(mean));
        document.getElementById('geom-k-pmf').value = k;
        document.getElementById('geom-slider-pmf').value = k;
        document.getElementById('geom-k-cdf').value = k;
        document.getElementById('geom-slider-cdf').value = k;
      }

      // PMF
      const pmf = geometricPmf(k, p);
      document.getElementById('geom-pmf-label').textContent = `P(X = ${k})`;
      document.getElementById('geom-pmf-val').textContent = pmf.toFixed(4);
      document.getElementById('geom-pmf-pct').textContent = `${(pmf * 100).toFixed(2)}%`;
      document.getElementById('geom-pmf-exp').textContent = `The probability that the first success occurs exactly on trial ${k} is ${(pmf * 100).toFixed(2)}%.`;

      // CDF
      const cdf = geometricCdf(k, p);
      const survival = Math.max(0, 1 - cdf);
      document.getElementById('geom-cdf-leq-lbl').textContent = `P(X \u2264 ${k})`;
      document.getElementById('geom-cdf-gt-lbl').textContent = `P(X > ${k})`;
      document.getElementById('geom-cdf-leq-val').textContent = cdf.toFixed(4);
      document.getElementById('geom-cdf-leq-pct').textContent = `${(cdf * 100).toFixed(2)}%`;
      document.getElementById('geom-cdf-gt-val').textContent = survival.toFixed(4);
      document.getElementById('geom-cdf-gt-pct').textContent = `${(survival * 100).toFixed(2)}%`;
      document.getElementById('geom-exp-k').textContent = k;
      document.getElementById('geom-exp-kgt').textContent = k;

      updateGeometricChart(p, k);
    }

    // ==========================================
    // EVENT LISTENERS & SETUP
    // ==========================================
    // Binomial inputs
    document.getElementById('bin-input-n').addEventListener('input', computeBinomial);
    document.getElementById('bin-input-p').addEventListener('input', computeBinomial);
    document.getElementById('bin-k-pmf').addEventListener('input', (e) => syncBinomialK(e.target.value));
    document.getElementById('bin-slider-pmf').addEventListener('input', (e) => syncBinomialK(e.target.value));
    document.getElementById('bin-k-cdf').addEventListener('input', (e) => syncBinomialK(e.target.value));
    document.getElementById('bin-slider-cdf').addEventListener('input', (e) => syncBinomialK(e.target.value));

    // Poisson inputs
    document.getElementById('pois-input-lambda').addEventListener('input', computePoisson);
    document.getElementById('pois-k-pmf').addEventListener('input', (e) => syncPoissonK(e.target.value));
    document.getElementById('pois-slider-pmf').addEventListener('input', (e) => syncPoissonK(e.target.value));
    document.getElementById('pois-k-cdf').addEventListener('input', (e) => syncPoissonK(e.target.value));
    document.getElementById('pois-slider-cdf').addEventListener('input', (e) => syncPoissonK(e.target.value));

    // Geometric inputs
    document.getElementById('geom-input-p').addEventListener('input', computeGeometric);
    document.getElementById('geom-k-pmf').addEventListener('input', (e) => syncGeometricK(e.target.value));
    document.getElementById('geom-slider-pmf').addEventListener('input', (e) => syncGeometricK(e.target.value));
    document.getElementById('geom-k-cdf').addEventListener('input', (e) => syncGeometricK(e.target.value));
    document.getElementById('geom-slider-cdf').addEventListener('input', (e) => syncGeometricK(e.target.value));

    function renderMath() {
      if (window.renderMathInElement) {
        renderMathInElement(document.body, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '\\[', right: '\\]', display: true },
            { left: '\\(', right: '\\)', display: false },
            { left: '$', right: '$', display: false }
          ],
          throwOnError: false
        });
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      computeBinomial();
      computePoisson();
      computeGeometric();
      setTimeout(renderMath, 200);
    });
  </script>
</body>
